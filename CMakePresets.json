{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Zafiro: C++ base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON" }
    },
    {
      "name": "all-adapters",
      "displayName": "Zafiro: Python + JavaScript + Lua",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/all-adapters",
      "cacheVariables": {
        "ZAFIRO_WITH_PYTHON": "ON",
        "ZAFIRO_WITH_JAVASCRIPT": "ON",
        "ZAFIRO_WITH_LUA": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "all-adapters", "configurePreset": "all-adapters" }
  ],
  "testPresets": [
    { "name": "default", "configurePreset": "default", "output": { "outputOnFailure": true } },
    { "name": "all-adapters", "configurePreset": "all-adapters", "output": { "outputOnFailure": true } }
  ]
}
